{% extends 'base.html.twig' %}

{% block title %}Show Client!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    
    <h1>Détails du client</h1>

    <p> Nom : {{ client.nom }} {{ client.prenom }} - Email : {{ client.email }} </p>
    <p> Téléphone : {{ client.telephone }}  </p>

    
    <a href="{{ path('app_client_edit', {id: client.id}) }} ">Modifier </a>
    <form method="post" action="{{ path('app_client_delete', {id: client.id}) }}" onsubmit="return confirm('Supprimer ce client ?');">
        <input type="hidden" name="_token" value="{{ csrf_token('delete_client_' ~ client.id) }}">
        <button type="submit">Supprimer</button>
    </form>
    
    
    <p><b>Commandes passées :</b></p>

    {% for commande in client.commandes %}

        <p>
            {{ commande.numero }} - {{ commande.date|date('d/m/Y') }} -- {{ commande.statut }} -- <a href="{{ path('app_commande_show', {id: commande.id}) }} ">détails </a>
        </p>

    {% else %}

        <p> Aucune commande. </p>

    {% endfor %}

    

</div>
{% endblock %}
